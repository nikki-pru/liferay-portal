Bundle-Name: Liferay Push Notifications Sender Firebase
Bundle-SymbolicName: com.liferay.push.notifications.sender.firebase
Bundle-Version: 5.0.18
Import-Package:\
	!android.*,\
	\
	!io.reactivex.*,\
	\
	!org.bouncycastle.*,\
	\
	!org.conscrypt.*,\
	\
	!org.openjsse.javax.net.ssl.*,\
	!org.openjsse.net.ssl.*,\
	\
	*
-fixupmessages: "^Classes found in the wrong directory: \\\\{META-INF/versions/9/";is:=warning